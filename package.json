{
  "name": "skin-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "dev:e2e": "vite --config vite.config.e2e.js",
    "e2e": "playwright test",
    "e2e:fast": "playwright test navigation.spec.js person.spec.js auth.spec.js ui-budget.spec.js --reporter=dot",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "e2e:visual": "playwright test visual",
    "e2e:visual:update": "playwright test visual --update-snapshots"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@supabase/supabase-js": "^2.45.4",
    "browser-image-compression": "^2.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "react-zoom-pan-pinch": "^4.2.0",
    "recharts": "^2.12.7",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^4.3.1",
    "tailwindcss": "^4.1.0",
    "vite": "^5.4.8",
    "vitest": "^2.1.9",
    "web-push": "^3.6.7"
  }
}
