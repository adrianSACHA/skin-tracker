# UWAGA: ten plik nazywa się `env.example`.
# Zmień nazwę na `.env.example` (z kropką na początku) w swoim repo,
# albo od razu skopiuj jego zawartość do pliku `.env` (który jest w .gitignore).
#
# Wartości znajdziesz w Supabase: Project Settings -> API.
#   VITE_SUPABASE_URL       -> "Project URL"
#   VITE_SUPABASE_ANON_KEY  -> "Project API keys" -> anon / public
#
# anon key trafia do builda frontendu (to normalne) - dane chroni RLS + Auth.
# NIGDY nie używaj tutaj klucza service_role.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Web Push (przypomnienia w tle). Publiczny klucz VAPID.
# Wygeneruj parę:  npx web-push generate-vapid-keys
#   VITE_VAPID_PUBLIC_KEY -> klucz PUBLICZNY (trafia do frontendu - to normalne)
#   VAPID_PRIVATE_KEY     -> NIGDY tutaj; ustaw jako sekret GitHub Actions
VITE_VAPID_PUBLIC_KEY=YOUR-VAPID-PUBLIC-KEY
